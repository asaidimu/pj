#!/usr/bin/env sh

# @about     Example scaffold built on pj's app layer
# @flag      -n, --name=<who>    whom to greet (default: world)
# @route     hello               greet someone
# @route     info                show script info
# @default   hello

. "${FRAMEWORK_LIB:-$HOME/.local/share/pj/lib}/io.sh"

hello(){
  inform "hello ${OPT_NAME:-world} from ${SCRIPT_NAME}"
}

info(){
  inform "${SCRIPT_NAME}: scaffold using the pj app layer"
}

app_start "$@"

