# regenerate the project list: one path per line, the /.pj or /.git
# marker stripped, deduped. (Sourced in the framework shell.)
{
  find "$PROJECTS_PATH" -maxdepth 4 -name ".pj" -print
  find "$PROJECTS_PATH" -maxdepth 4 -name ".git" -print
} | sed -E 's#/\.(pj|git)$##' | sort -u > "$PROJECTS_LIST"
